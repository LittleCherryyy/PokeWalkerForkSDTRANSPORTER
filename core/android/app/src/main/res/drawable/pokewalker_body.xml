<?xml version="1.0" encoding="utf-8"?>
<!-- Pokeball-style body: red top, black band, white bottom, done as a
     single radial-free linear gradient on an oval so it needs no images. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <gradient
        android:angle="90"
        android:type="linear"
        android:startColor="#E0455B"
        android:centerColor="#E0455B"
        android:centerY="0.46"
        android:endColor="#1A1A1A" />
</shape>
