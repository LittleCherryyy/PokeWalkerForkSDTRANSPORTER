<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_fallback_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foregroundGravity="center"
    android:background="#10202C">

    <FrameLayout
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Pokéwalker"
            android:scaleType="fitCenter"
            android:src="@drawable/walker_shell" />

        <TextView
            android:id="@+id/widget_fallback_text"
            android:layout_width="88dp"
            android:layout_height="61dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="42dp"
            android:background="#B8BDAA"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="3"
            android:padding="3dp"
            android:text="ADD WIDGET"
            android:textColor="#232B1D"
            android:textSize="9sp"
            android:textStyle="bold" />
    </FrameLayout>
</FrameLayout>
