<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <RelativeLayout
        android:id="@+id/widget_device"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_centerInParent="true">

        <ImageView
            android:id="@+id/widget_shell"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/walker_shell"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/widget_lcd"
            android:layout_width="154dp"
            android:layout_height="108dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="73dp"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/widget_screen_touch"
            android:layout_width="154dp"
            android:layout_height="108dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="73dp"
            android:text="" />

        <TextView
            android:id="@+id/widget_left"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="42dp"
            android:layout_marginBottom="21dp"
            android:text="" />

        <TextView
            android:id="@+id/widget_center"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="14dp"
            android:text="" />

        <TextView
            android:id="@+id/widget_right"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="42dp"
            android:layout_marginBottom="21dp"
            android:text="" />
    </RelativeLayout>
</RelativeLayout>
