<?xml version="1.0" encoding="utf-8"?>
<!-- All colors are in one oval, avoiding the old second oval which
     covered or distorted the body when a launcher resized the widget. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="270"
        android:type="linear"
        android:startColor="#DB4055"
        android:centerColor="#D33A51"
        android:centerY="0.43"
        android:endColor="#F5F5F1" />
    <stroke android:width="1dp" android:color="#B7B7B3" />
</shape>
