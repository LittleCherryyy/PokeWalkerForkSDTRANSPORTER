<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The launcher may give the widget a rectangular cell.  Keep the
         physical walker a fixed square so its circular shape never stretches. -->
    <FrameLayout
        android:layout_width="184dp"
        android:layout_height="184dp"
        android:layout_gravity="center">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Pokewalker"
            android:background="@drawable/pokewalker_body" />

        <!-- Fixed LCD bounds: do not use layout_weight or zero-height views
             in launcher RemoteViews.  They can collapse on some launchers. -->
        <LinearLayout
            android:id="@+id/widget_screen"
            android:layout_width="138dp"
            android:layout_height="91dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="34dp"
            android:orientation="vertical"
            android:padding="5dp"
            android:background="@drawable/pokewalker_screen">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:text="♪"
                    android:textColor="#293322"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/widget_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Walker 1"
                    android:textColor="#293322"
                    android:textSize="9sp"
                    android:gravity="end"
                    android:fontFamily="monospace"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_main"
                android:layout_width="match_parent"
                android:layout_height="23dp"
                android:text="No partner"
                android:textColor="#293322"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:maxLines="2" />

            <TextView
                android:id="@+id/widget_steps"
                android:layout_width="match_parent"
                android:layout_height="27dp"
                android:gravity="end|center_vertical"
                android:text="0"
                android:textColor="#293322"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0 watts"
                android:textColor="#293322"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="31dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_refresh"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:gravity="center"
                android:text="◀"
                android:textColor="#777770"
                android:textSize="12sp"
                android:background="@drawable/pokewalker_button_round" />
            <ImageView android:layout_width="16dp" android:layout_height="1dp" />
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/pokewalker_button_round" />
            <ImageView android:layout_width="16dp" android:layout_height="1dp" />
            <TextView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:gravity="center"
                android:text="▶"
                android:textColor="#777770"
                android:textSize="12sp"
                android:background="@drawable/pokewalker_button_round" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
